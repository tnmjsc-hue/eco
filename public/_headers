/data/latest.json
  Cache-Control: public, max-age=0, must-revalidate
/data/status.json
  Cache-Control: public, max-age=0, must-revalidate
/data/network-proxies/latest.json
  Cache-Control: public, max-age=0, must-revalidate
/data/network-proxies/status.json
  Cache-Control: public, max-age=0, must-revalidate
/data/network-proxies/releases/*
  Cache-Control: public, max-age=31536000, immutable

/data/extended/latest.json
  Cache-Control: no-cache, max-age=0, must-revalidate

/data/extended/status.json
  Cache-Control: no-cache, max-age=0, must-revalidate

/data/extended/releases/*
  Cache-Control: public, max-age=31536000, immutable
/data/releases/*
  Cache-Control: public, max-age=31536000, immutable
/data/publications/*
  Cache-Control: public, max-age=31536000, immutable
/data/revisions/*
  Cache-Control: public, max-age=31536000, immutable
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
